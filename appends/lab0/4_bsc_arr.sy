// Input: 5
// Output: 15

/*
 * 4_bsc_array.sy
 * Purpose:
 * - array declarations & indexing
 * - array parameters
 * - multidimensional array parameter form
 * - repeated l_val indexing
 * Input: integer k
 * Output: sum
 */

int sum2(int a[][2], int n) {
    int i = 0;
    int s = 0;
    while (i < n) {
        s = s + a[i][0] + a[i][1];
        i = i + 1;
    }
    return s;
}

int main() {
    int k = read();
    int m[2][2] = {{1, 2}, {3, 4}};
    int sum = 0;

    m[1][0] = m[1][0] + k;
    sum = sum2(m, 2);

    write(sum);
    return 0;
}
